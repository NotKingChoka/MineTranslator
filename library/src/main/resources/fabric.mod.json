{
  "schemaVersion": 1,
  "id": "minetranslatorlib",
  "version": "${version}",
  "name": "MineTranslator Library",
  "description": "Standalone client hook library required by MineTranslator.",
  "authors": ["NotKingChoka"],
  "license": "MIT",
  "environment": "client",`n  "icon": "icon.png",
  "entrypoints": {
    "client": [
      "net.kingchoka.minetranslatorlib.fabric.MineTranslatorLibraryMod"
    ]
  },
  "mixins": [
    "minetranslator-library.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version_fabric_range}",
    "fabricloader": "${fabric_loader_version_range}"
  }
}
