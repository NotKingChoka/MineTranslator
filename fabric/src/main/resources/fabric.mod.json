{
  "schemaVersion": 1,
  "id": "minetranslator",
  "version": "${version}",
  "name": "Translator++",
  "description": "A mod for swift, light and convenient auto translation.",
  "authors": [
    "NotKingChoka"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/translator++",
    "sources": "https://github.com/pSUNSET/MineTranslator",
    "issues": "https://github.com/pSUNSET/MineTranslator/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.kingchoka.minetranslator.fabric.MineTranslatorImpl"
    ],
    "modmenu": [
      "net.kingchoka.minetranslator.compat.fabric.modmenu.MTModMenuIntegration"
    ],
    "jade": [
      "net.kingchoka.minetranslator.compat.jade.MTCompatJade"
    ]
  },
  "mixins": [
    "minetranslator.mixins.json",
    "minetranslator.fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version_fabric_range}",
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}"
  }
}
