{
  "schemaVersion": 1,
  "id": "minetranslator",
  "version": "${version}",
  "name": "MineTranslator",
  "description": "A mod for swift, light and convenient auto translation.",
  "authors": [
    "NotKingChoka"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/MineTranslator",
    "sources": "https://github.com/NotKingChoka/MineTranslator",
    "issues": "https://github.com/NotKingChoka/MineTranslator/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.kingchoka.minetranslator.fabric.MineTranslatorImpl"
    ],
    "minetranslator-library": [
      "net.kingchoka.minetranslator.fabric.MineTranslatorLibraryIntegration"
    ]
  },
  "mixins": [
    "minetranslator.mixins.json",
    "minetranslator.fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version_fabric_range}",
    "fabricloader": "${fabric_loader_version_range}",
    "minetranslatorlib": ">=${minetranslator_library_version}"
  }
}
