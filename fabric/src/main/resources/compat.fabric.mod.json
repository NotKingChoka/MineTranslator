{
  "schemaVersion": 1,
  "id": "minetranslator-compat",
  "version": "${version}",
  "name": "MineTranslator Compatibility Library",
  "description": "A compatibility library for MineTranslator containing mixins and GUI renderers.",
  "authors": [
    "NotKingChoka"
  ],
  "contact": {
    "homepage": "https://github.com/NotKingChoka/MineTranslator"
  },
  "license": "MIT",
  "icon": "icon.png",
  "entrypoints": {
    "client": [
      "net.kingchoka.minetranslator.compat.fabric.MTCompatFabricClient"
    ]
  },
  "mixins": [
    "minetranslator.mixins.json",
    "minetranslator.fabric.mixins.json"
  ],
  "accessWidener": "minetranslator.accesswidener",
  "depends": {
    "minecraft": "${minecraft_version_fabric_range}",
    "fabricloader": "${fabric_loader_version_range}",
    "minetranslator": "*"
  }
}
